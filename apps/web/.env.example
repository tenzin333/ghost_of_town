# Copy to .env.local. Everything is optional; restart `pnpm dev` after changes.

# Database (Supabase). Leave the URL unset to use the bundled data/places.json.
# Both are required together: the URL without the key fails with 401 "No API key found".
NEXT_PUBLIC_DATA_API_URL=https://<project-ref>.supabase.co/rest/v1
NEXT_PUBLIC_DATA_API_KEY=<publishable or anon key, never the service_role/secret key>

# Google Street View inside the app (Maps Embed API + Street View Static API metadata, both no-charge).
# Without it, "Today" opens Street View in Google Maps in a new tab. Restrict the key by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# LOCAL DEVELOPMENT ONLY: unofficial keyless Google Street View embed in "Today" (Google (dev) tab). Not allowed by
# Google's terms for real use and may break; `next build` compiles it out regardless of this value.
NEXT_PUBLIC_GOOGLE_KEYLESS_DEV=

# Mapillary street photos (free client token from mapillary.com/dashboard/developers; public by design).
# Used for "Today" where Google has no imagery, and for green photo-coverage lines on the map.
NEXT_PUBLIC_MAPILLARY_TOKEN=

# Analytics (Umami Cloud).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
